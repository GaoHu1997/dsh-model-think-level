{
  "name": "dsh-model-think-level",
  "version": "1.0.0",
  "description": "Thinking levels, vision badges and request headers for third-party models in DeepSeek Harness: pick a provider and a model inside the composer menu, gate a model's reasoning with one switch in the official Models page card, and configure per-route request headers.",
  "license": "MIT",
  "author": "GaoHu1997 <gaohu9712@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaoHu1997/dsh-model-think-level.git"
  },
  "homepage": "https://github.com/GaoHu1997/dsh-model-think-level",
  "bugs": {
    "url": "https://github.com/GaoHu1997/dsh-model-think-level/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-model-think-level",
    "reasoning-effort",
    "reasoning",
    "thinking",
    "input-modality",
    "modalities",
    "vision",
    "request-headers",
    "llm-settings"
  ],
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "protobufjs"
    ]
  },
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets/",
    "docs/*.svg",
    "icon.svg",
    "locale/*.json"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:host && npm run build:client && npm run build:types",
    "build:clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "check:styles": "node scripts/check-styles.mjs",
    "build:client": "npm run check:styles && node scripts/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "build:host": "node scripts/build-host.mjs",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.0",
    "jsdom": "^27.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
